# Boston GSI Overlay Fix - V2 cosmetic device-identity props
# Purpose: populate About-phone / device-info fields that read as "Unknown"
# on this GSI build, using standard, real Android build properties only.
#
# NOT included, and why: battery capacity (mAh) and camera megapixel count
# have no standard build.prop equivalent in AOSP. Those fields are read
# from live hardware APIs (BatteryManager / Camera2 characteristics) that a
# GSI's HAL either does or doesn't populate correctly - a resetprop value
# has no path into those specific fields. Setting an invented prop name for
# them would silently do nothing, which is worse than leaving this note.
#
# Source for values: user-supplied device specs, cross-checked against this
# conversation's own confirmed findings where overlap exists (resolution,
# platform codename). Not independently re-verified against a firmware
# dump for every field - see inline notes.

# Confirmed independently in this investigation (1080x2400, from
# SurfaceFlinger dump and framework RRO decode, several sessions ago)
ro.sf.lcd_density=400

# Confirmed independently (ro.board.platform / ro.product.vendor.board
# checks against 'parrot' in customize.sh's device-match logic)
ro.board.platform=parrot

# User-supplied, not independently verified against a firmware dump
ro.product.model=Moto G Stylus 5G 2024
ro.product.manufacturer=motorola
ro.product.brand=motorola

# ====================================================================
# Telephony, part 1: LTE/5G data recovery (confirmed working)
#
# Confirmed on-device, by the person who built this module, across
# repeated real-world testing: with this property set active, LTE/5G
# data registration comes up reliably on both Grameenphone and Airtel/
# Robi after a GSI flash. Without it, data is confirmed stuck on EDGE.
# This was tested as a full bundle, not property-by-property in
# isolation (isolation testing was deferred pending a clean GSI flash,
# which wasn't available at the time this was merged) - so which
# individual line(s) are load-bearing vs. inert alongside the real fix
# is not yet known.
#
# ro.boot.hardware.sku and telephony.lteOnCdmaDevice from the original
# source module are excluded on structural grounds: ro.boot.* cannot be
# overridden by a system.prop/resetprop entry applied late in boot, and
# lteOnCdmaDevice does not apply to this GSM/LTE/5G-NR radio.
#
# The original bundle's IMS-related properties
# (persist.dbg.volte_avail_ovr, vt_avail_ovr, wfc_avail_ovr,
# persist.sys.phh.ims.caf) have been REMOVED here - they were blunt,
# unverified attempts at the same problem part 2 below now addresses
# properly, via AOSP's real, documented CarrierConfig keys
# (support_sms_over_ims_bool / support_ussd_over_ims_bool) scoped to
# the correct MCC/MNC, rather than global override flags of unconfirmed
# effect.

persist.vendor.radio.atfwd.start=true
ro.telephony.default_network=33
persist.radio.rat_on=combine
persist.sys.phh.radio.force_user_network_setting=true
persist.vendor.radio.force_on_dc=true
persist.vendor.radio.data_ltd_sys_ind=1
ro.telephony.euicc_device_enabled=true
persist.radio.multisim.config=dsds

# ====================================================================
# Telephony, part 2: SMS/USSD-over-IMS bypass (NOT YET ON-DEVICE
# CONFIRMED as of this merge)
#
# Source: a separate module (moto-parrot-telephony-fix, "V3.0-BruteForce")
# supplied later in this investigation, after an earlier merge attempt
# had been built against a DIFFERENT, incorrect reference module by
# mistake. This is the correct one.
#
# Mechanism, and why it's a materially better approach than "force IMS
# on and hope registration succeeds" (which several turns of this
# investigation spent trying, via a CarrierSettings .pb edit targeting
# carrier_volte_available_bool / iwlan.epdg_static_address_string - see
# docs/telephony_investigation.md and docs/telephony_v3_merge.md): this
# module does not try to fix IMS registration for SMS/USSD at all. It
# tells the framework, via the real, standard AOSP CarrierConfig keys
# support_sms_over_ims_bool and support_ussd_over_ims_bool (set false,
# scoped correctly to MCC 470 / MNC 01 Grameenphone and MNC 02
# Airtel/Robi in overlay/system/etc/carrier_config_fix.xml), to route
# SMS and USSD over the legacy circuit-switched (CS/GSM) domain
# instead, which does not depend on IMS registration succeeding.
#
# A real logcat capture during this investigation confirmed the CS
# domain reports registrationState=HOME and
# availableServices=[VOICE,SMS,VIDEO] on this device, immediately
# following an IMS registration failure (the same
# CODE_REGISTRATION_ERROR / sub-code 4002 seen throughout this whole
# investigation) - meaning the CS fallback path this module relies on
# is confirmed genuinely available, not just theoretically.
#
# This property clamps IMS-over-calls specifically (separate from the
# SMS/USSD-over-IMS keys above, which live in carrier_config_fix.xml,
# not here) as part of the same module's original design:
persist.radio.calls.on.ims=0

